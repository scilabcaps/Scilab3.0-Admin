<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<?import javafx.scene.control.ScrollPane?>
<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.scalib.controller.ReservationHistoryController"
      spacing="0" styleClass="page-root">
    <stylesheets>
        <URL value="@tableDesign.css"/>
    </stylesheets>

    <!-- Header -->
    <VBox styleClass="page-header">
        <padding>
            <Insets top="32" right="32" bottom="20" left="32"/>
        </padding>
        <Label styleClass="page-title" text="Inventory"/>
        <Label styleClass="page-subtitle"
               text="Review completed reservation logs and search by date, room, or requester."
               wrapText="true"/>
    </VBox>

    <!-- Toolbar -->
    <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="10">
        <padding>
            <Insets top="0" right="32" bottom="20" left="32"/>
        </padding>
        <DatePicker fx:id="datePicker"
                    promptText="Filter by date…"
                    maxWidth="260"
                    styleClass="search-datepicker"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Search" styleClass="btn-primary"/>
        <Button text="Clear"  styleClass="btn-ghost"/>
    </HBox>

    <!-- Table card -->
    <VBox VBox.vgrow="ALWAYS" styleClass="table-card">
        <padding>
            <Insets left="32" right="32" bottom="0" top="0"/>
        </padding>

        <VBox styleClass="table-wrap" VBox.vgrow="ALWAYS">

            <!-- Table header row -->
            <GridPane styleClass="table-header-row">
                <columnConstraints>
                    <ColumnConstraints percentWidth="12"/>
                    <ColumnConstraints percentWidth="14"/>
                    <ColumnConstraints percentWidth="13"/>
                    <ColumnConstraints percentWidth="12"/>
                    <ColumnConstraints percentWidth="29"/>
                    <ColumnConstraints percentWidth="12"/>
                    <ColumnConstraints percentWidth="8"/>
                </columnConstraints>
                <Label text="DATE"     styleClass="th" GridPane.columnIndex="0"/>
                <Label text="TIME"     styleClass="th" GridPane.columnIndex="1"/>
                <Label text="USER"     styleClass="th" GridPane.columnIndex="2"/>
                <Label text="TYPE"     styleClass="th" GridPane.columnIndex="3"/>
                <Label text="RESOURCES" styleClass="th" GridPane.columnIndex="4"/>
                <Label text="STATUS"   styleClass="th" GridPane.columnIndex="5"/>
                <Label text="ACTION"   styleClass="th" GridPane.columnIndex="6"/>
            </GridPane>

            <!-- Scrollable body -->
            <ScrollPane fitToWidth="true" styleClass="table-scroll" VBox.vgrow="ALWAYS">
                <GridPane styleClass="table-body" fx:id="tableGrid">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="12"/>
                        <ColumnConstraints percentWidth="14"/>
                        <ColumnConstraints percentWidth="13"/>
                        <ColumnConstraints percentWidth="12"/>
                        <ColumnConstraints percentWidth="29"/>
                        <ColumnConstraints percentWidth="12"/>
                        <ColumnConstraints percentWidth="8"/>
                    </columnConstraints>

                    <!-- Row 1 -->
                    <Label text="2025-12-09"       styleClass="td"         GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label text="14:12 – 14:13"    styleClass="td,td-mono" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="A A"               styleClass="td"         GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <HBox styleClass="td" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <Label text="Student" styleClass="chip-student"/>
                    </HBox>
                    <Label text="Acetic acid (6.00×)" styleClass="td,td-res" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                    <HBox styleClass="td" GridPane.columnIndex="5" GridPane.rowIndex="0">
                        <Label text="✓  Completed" styleClass="chip-done"/>
                    </HBox>
                    <HBox styleClass="td" GridPane.columnIndex="6" GridPane.rowIndex="0">
                        <Button text="View" styleClass="btn-view"/>
                    </HBox>

                    <!-- Row 2 -->
                    <Label text="2025-12-09"       styleClass="td,td-alt"  GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Label text="13:55 – 13:56"    styleClass="td,td-mono,td-alt" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="A A"               styleClass="td,td-alt"  GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <HBox styleClass="td,td-alt" GridPane.columnIndex="3" GridPane.rowIndex="1">
                        <Label text="Student" styleClass="chip-student"/>
                    </HBox>
                    <Label text="Watch glass (1×)" styleClass="td,td-res,td-alt" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                    <HBox styleClass="td,td-alt" GridPane.columnIndex="5" GridPane.rowIndex="1">
                        <Label text="✓  Completed" styleClass="chip-done"/>
                    </HBox>
                    <HBox styleClass="td,td-alt" GridPane.columnIndex="6" GridPane.rowIndex="1">
                        <Button text="View" styleClass="btn-view"/>
                    </HBox>

                    <!-- Row 3 -->
                    <Label text="2025-12-09"       styleClass="td"         GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label text="13:47 – 13:49"    styleClass="td,td-mono" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="A A"               styleClass="td"         GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <HBox styleClass="td" GridPane.columnIndex="3" GridPane.rowIndex="2">
                        <Label text="Student" styleClass="chip-student"/>
                    </HBox>
                    <Label text="Test tube (4×)"   styleClass="td,td-res"  GridPane.columnIndex="4" GridPane.rowIndex="2"/>
                    <HBox styleClass="td" GridPane.columnIndex="5" GridPane.rowIndex="2">
                        <Label text="✓  Completed" styleClass="chip-done"/>
                    </HBox>
                    <HBox styleClass="td" GridPane.columnIndex="6" GridPane.rowIndex="2">
                        <Button text="View" styleClass="btn-view"/>
                    </HBox>

                    <!-- Row 4 -->
                    <Label text="2025-12-09"       styleClass="td,td-alt"  GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <Label text="13:35 – 13:38"    styleClass="td,td-mono,td-alt" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Label text="Prof Prof"         styleClass="td,td-alt"  GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                    <HBox styleClass="td,td-alt" GridPane.columnIndex="3" GridPane.rowIndex="3">
                        <Label text="Professor" styleClass="chip-prof"/>
                    </HBox>
                    <Label text="Watch glass (1×), Dropper (1×)" styleClass="td,td-res,td-alt" GridPane.columnIndex="4" GridPane.rowIndex="3"/>
                    <HBox styleClass="td,td-alt" GridPane.columnIndex="5" GridPane.rowIndex="3">
                        <Label text="✓  Completed" styleClass="chip-done"/>
                    </HBox>
                    <HBox styleClass="td,td-alt" GridPane.columnIndex="6" GridPane.rowIndex="3">
                        <Button text="View" styleClass="btn-view"/>
                    </HBox>

                    <!-- Row 5 -->
                    <Label text="2025-12-09"       styleClass="td"         GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <Label text="13:35 – 13:35"    styleClass="td,td-mono" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    <Label text="Prof Prof"         styleClass="td"         GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                    <HBox styleClass="td" GridPane.columnIndex="3" GridPane.rowIndex="4">
                        <Label text="Professor" styleClass="chip-prof"/>
                    </HBox>
                    <Label text="Biology Laboratory (1×)" styleClass="td,td-res" GridPane.columnIndex="4" GridPane.rowIndex="4"/>
                    <HBox styleClass="td" GridPane.columnIndex="5" GridPane.rowIndex="4">
                        <Label text="✓  Completed" styleClass="chip-done"/>
                    </HBox>
                    <HBox styleClass="td" GridPane.columnIndex="6" GridPane.rowIndex="4">
                        <Button text="View" styleClass="btn-view"/>
                    </HBox>

                    <!-- Row 6 -->
                    <Label text="2025-12-09"       styleClass="td,td-alt"  GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <Label text="12:00 – 13:00"    styleClass="td,td-mono,td-alt" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                    <Label text="Prof Prof"         styleClass="td,td-alt"  GridPane.columnIndex="2" GridPane.rowIndex="5"/>
                    <HBox styleClass="td,td-alt" GridPane.columnIndex="3" GridPane.rowIndex="5">
                        <Label text="Professor" styleClass="chip-prof"/>
                    </HBox>
                    <Label text="Biology Laboratory (1×)" styleClass="td,td-res,td-alt" GridPane.columnIndex="4" GridPane.rowIndex="5"/>
                    <HBox styleClass="td,td-alt" GridPane.columnIndex="5" GridPane.rowIndex="5">
                        <Label text="✓  Completed" styleClass="chip-done"/>
                    </HBox>
                    <HBox styleClass="td,td-alt" GridPane.columnIndex="6" GridPane.rowIndex="5">
                        <Button text="View" styleClass="btn-view"/>
                    </HBox>

                    <!-- Row 7 -->
                    <Label text="2025-12-09"       styleClass="td"         GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                    <Label text="11:52 – 00:52"    styleClass="td,td-mono" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                    <Label text="Prof Prof"         styleClass="td"         GridPane.columnIndex="2" GridPane.rowIndex="6"/>
                    <HBox styleClass="td" GridPane.columnIndex="3" GridPane.rowIndex="6">
                        <Label text="Professor" styleClass="chip-prof"/>
                    </HBox>
                    <Label text="Biology Laboratory (1×)" styleClass="td,td-res" GridPane.columnIndex="4" GridPane.rowIndex="6"/>
                    <HBox styleClass="td" GridPane.columnIndex="5" GridPane.rowIndex="6">
                        <Label text="✓  Completed" styleClass="chip-done"/>
                    </HBox>
                    <HBox styleClass="td" GridPane.columnIndex="6" GridPane.rowIndex="6">
                        <Button text="View" styleClass="btn-view"/>
                    </HBox>

                </GridPane>
            </ScrollPane>
        </VBox>
    </VBox>

    <!-- Footer -->
    <HBox styleClass="page-footer" alignment="CENTER_LEFT">
        <padding>
            <Insets top="12" right="32" bottom="16" left="32"/>
        </padding>
        <Label fx:id="userLabel" styleClass="footer-label" text="User: admin@admin.com"/>
    </HBox>
</VBox>
